---
import "../style/style.css";
import "../style/grid.css";
import DailyMixCard from "../components/DailyMixCard.astro";
import MixCard from "../components/MixCard.astro";
import Navigation from "../components/Navigation.astro";
import PlaylistsTop from "../components/PlaylistsTop.astro";
import Header from "../components/Header.astro";
import "/src/assets/dailymix.jpeg";
import "/src/assets/home_icon.png";
import Layout from "../layouts/Layout.astro";
---

<doctype html>
  <html lang="en">
    <head>
      <meta charset="UTF-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1.0" />
      <link rel="preconnect" href="https://fonts.googleapis.com" />
      <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
      <link
        href="https://fonts.googleapis.com/css2?family=Poppins:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;0,800;0,900;1,100;1,200;1,300;1,400;1,500;1,600;1,700;1,800;1,900&display=swap"
        rel="stylesheet"
      />
      <title>Spotify</title>
    </head>
    <Header />
    <body>
      <main>
        <div class="grid_1">
          <Navigation navigation="Alle" />
          <Navigation navigation="Musik" />
          <Navigation navigation="Podcasts" />
        </div>
        <div class="grid_1-1-1-1">
          <PlaylistsTop paragraph="SOS Deluxe: LANA" />
          <PlaylistsTop paragraph="SOS Deluxe: LANA" />
          <PlaylistsTop paragraph="SOS Deluxe: LANA" />
          <PlaylistsTop paragraph="SOS Deluxe: LANA" />
          <PlaylistsTop paragraph="SOS Deluxe: LANA" />
          <PlaylistsTop paragraph="SOS Deluxe: LANA" />
          <PlaylistsTop paragraph="SOS Deluxe: LANA" />
          <PlaylistsTop paragraph="SOS Deluxe: LANA" />
        </div>
        <h2>Specielt til Sille Birk Lassen</h2>
        <div class="grid_1-1-1-1-1">
          <DailyMixCard paragraph="Kendrick Lamar, Brent Fayiaz, SZA og mere" />
          <DailyMixCard paragraph="Kendrick Lamar, Brent Fayiaz, SZA og mere" />
          <DailyMixCard paragraph="Kendrick Lamar, Brent Fayiaz, SZA og mere" />
          <DailyMixCard paragraph="Kendrick Lamar, Brent Fayiaz, SZA og mere" />
          <DailyMixCard paragraph="Kendrick Lamar, Brent Fayiaz, SZA og mere" />
        </div>
        <h2>Dine mest populaere mix</h2>
        <div class="grid_1-1-1-1-1">
          <MixCard paragraph="Cleo Sol, Solange, Amy Winehouse og..." />
          <MixCard paragraph="Cleo Sol, Solange, Amy Winehouse og..." />
          <MixCard paragraph="Cleo Sol, Solange, Amy Winehouse og..." />
          <MixCard paragraph="Cleo Sol, Solange, Amy Winehouse og..." />
          <MixCard paragraph="Cleo Sol, Solange, Amy Winehouse og..." />
        </div>
      </main>
    </body>
  </html></doctype
>
